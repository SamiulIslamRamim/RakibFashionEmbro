generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ENUMS
enum Role {
  PRODUCTION_MANAGER
  SUPERVISOR
  CUTTING_HELPER
  MACHINE_OPERATOR
  MACHINE_HELPER
  FACTORY_OVERSEER
}

enum ShiftType {
  DAY
  NIGHT
}

enum AttendanceStatus {
  ABSENT
}

enum MachineStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PaymentType {
  WEEKLY_ADVANCE
  MONTHLY_SALARY_FINAL
  BONUS
}

enum ExpenseCategory {
  SNACKS
  RAW_MATERIALS // Threads, Needles, Backing
  MAINTENANCE   // Factory Maintenance(non-machine specific)
  UTILITY_BILL  // Current Bill
  OTHER
}
enum bloodGroupType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

enum isActiveType {
  ACTIVE
  INACTIVE
  SUSPENDED
}

// INFO: (User and Profile Merged)
model User {
  id                   String            @id @default(uuid())
  firstName            String
  lastName             String
  email                String            @unique
  password             String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  role                 Role?             @default(MACHINE_HELPER)
  isActive             isActiveType      @default(ACTIVE)
  isVerified           Boolean           @default(false)
  verificationCode     String?
  verificationExpiry   DateTime?

  // --- MERGED PROFILE FIELDS START ---
  baseSalary           Decimal           @default(0)
  bloodGroup           bloodGroupType?
  phone                String?
  emergencyContact     String?
  presentAddress       String?
  permanentAddress     String?
  joiningDate          DateTime?         @default(now())
  dateOfBirth          DateTime?
  // Relations
  assignments          MachineAssignment[]
  rosterEntries        ShiftRoster[]
  payments             Payment[]
}

model Machine {
  id                   String            @id @default(uuid())
  machineNumber        String            @unique
  headCount            Int               @default(0)
  status               MachineStatus     @default(ACTIVE)

  // Relations
  assignments          MachineAssignment[]
  maintenanceLogs      Maintenance[]
  productionLogs       ProductionLog[]
}


// INFO: Attendance & Shifts
model ShiftRoster {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id])
  shift                ShiftType         
  clockIn              DateTime?
  clockOut             DateTime?
  calculatedDurationHours Float?
  overtimeHours        Float             @default(0)
  status               AttendanceStatus? 
  remarks              String?

  primaryProduction    ProductionLog[]   @relation("PrimaryOperatorProduction")
  secondaryProduction  ProductionLog[]   @relation("SecondaryOperatorProduction")

  @@unique([userId, clockIn])
  @@index([userId, clockIn])
}

// INFO: New model for defining production jobs and targets
model ProductionTarget {
  id                   String    @id @default(uuid())
  date                 DateTime  @default(now()) // When the target was set or for which date
  memo                 String?
  size                 String?   // e.g., "26/32"
  designName           String?
  designCode           String    
  type                 String?   // e.g., "Embroidery", "Stitching", etc.
  quantity             Int       // The total number of items needed
  unitPrice            Decimal   // Price per unit for calculation
  target               Int       

  // Relations
  productionLogs       ProductionLog[] 
}

// INFO: Production Log
model ProductionLog {
  id                   String    @id @default(uuid())
  date                 DateTime  @default(now())

  productionTargetId   String
  productionTarget     ProductionTarget @relation(fields: [productionTargetId], references: [id])

  primaryOperatorRosterId  String
  primaryOperatorRoster    ShiftRoster @relation("PrimaryOperatorProduction", fields: [primaryOperatorRosterId], references: [id])
  secondaryOperatorRosterId String?
  secondaryOperatorRoster   ShiftRoster? @relation("SecondaryOperatorProduction", fields: [secondaryOperatorRosterId], references: [id])

  machineId            String
  machine              Machine   @relation(fields: [machineId], references: [id])

  stitchCount          Int
  stopCount            Int?

  @@index([primaryOperatorRosterId, machineId])
}


// INFO: Financial & Asset Logs
model Payment {
  id                   String    @id @default(uuid())
  date                 DateTime  @default(now())
  userId               String
  user                 User      @relation(fields: [userId], references: [id])
  amount               Decimal
  type                 PaymentType
  notes                String?
}

// Factory Expenses (General Costs)
model Expense {
  id                   String    @id @default(uuid())
  date                 DateTime  @default(now())
  category             ExpenseCategory
  itemName             String
  amount               Decimal
}

// Machine-Specific Maintenance Log
model Maintenance {
  id                   String    @id @default(uuid())
  machineId            String
  machine              Machine   @relation(fields: [machineId], references: [id])
  date                 DateTime  @default(now())
  cost                 Decimal
  reason               String?
  technician           String?
  techCharge           Int?
}


// Machine Assignments
model MachineAssignment {
  id                   String    @id @default(uuid())

  machineId            String
  machine              Machine   @relation(fields: [machineId], references: [id])

  userId               String
  user                 User      @relation(fields: [userId], references: [id])

  assignedAt           DateTime  @default(now())
  endedAt              DateTime?
  isActive             Boolean   @default(true)

  @@index([userId, isActive])
}