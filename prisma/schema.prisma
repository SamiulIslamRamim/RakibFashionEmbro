generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}



//note: Experimental feature

enum Role {
  PRODUCTION_MANAGER
  SUPERVISOR
  CUTTING_HELPER
  MACHINE_OPERATOR
  MACHINE_HELPER
  FACTORY_OVERSEER
}

enum ShiftType {
  DAY
  NIGHT
}

enum AttendanceStatus {
  ABSENT          // Deducts salary
  SICK_LEAVE
  FESTIVAL_LEAVE
}

enum MachineStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PaymentType {
  WEEKLY_ADVANCE
  MONTHLY_SALARY_FINAL
  BONUS
}

enum ExpenseCategory {
  SNACKS
  RAW_MATERIALS // Threads, Needles, Backing
  MAINTENANCE   // Factory Maintenance(non-machine specific)
  UTILITY_BILL  // Current Bill
  OTHER
}

//INFO: (User, Profile, Machine)
model User {  //fix: User vul disi
  id                     String             @id @default(uuid())
  firstName              String
  lastName               String
  email                  String             @unique
  passwordHash           String
  isVerified             Boolean   @default(false)
  verificationCode       String?
  verificationExpiry     DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  role                   Role               @default(MACHINE_HELPER)
  isActive               Boolean            @default(true) 


  // Relations
  profile                Profile?
  assignments            MachineAssignment[]
  rosterEntries          ShiftRoster[]      
  payments               Payment[]
}

model Profile {
  id                     String             @id @default(uuid())
  userId                 String             @unique
  user                   User               @relation(fields: [userId], references: [id])
  baseSalary             Decimal            @default(0)
  bloodGroup             String?
  phone                  String?
  emergencyContact       String?
  presentAddress         String?
  permanentAddress       String?
  joiningDate            DateTime?           @default(now())
}

model Machine {
  id                     String             @id @default(uuid())
  machineNumber          String             @unique
  headCount              Int                @default(0)
  status                 MachineStatus      @default(ACTIVE)


  // Relations
  assignments            MachineAssignment[]
  maintenanceLogs        Maintenance[]
  productionLogs          ProductionLog[]     
}


//INFO: Attendance, Production & Roster
model ShiftRoster {
  id                      String             @id @default(uuid())
  userId                  String
  user                    User               @relation(fields: [userId], references: [id])
  shift                   ShiftType          // DAY or NIGHT
  clockIn                 DateTime?           
  clockOut                DateTime?          
  calculatedDurationHours Float?             
  overtimeHours           Float              @default(0)
  status                  AttendanceStatus?  // Only record status if they are NOT working
  remarks                 String?


  // Relations 
  operatorProduction      ProductionLog[]    @relation("OperatorProduction")
  helperProduction        ProductionLog[]    @relation("HelperProduction")
  
  // Indexing for fast lookups by user and date
  @@unique([userId, clockIn]) 
  @@index([userId, clockIn])
}


model ProductionLog {
  id                     String             @id @default(uuid())
  date                   DateTime           @default(now())

  // Link to the Operator's Roster entry (their time log)
  operatorRosterId       String
  operatorRoster         ShiftRoster        @relation("OperatorProduction", fields: [operatorRosterId], references: [id])

  // Link to the Helper's Roster entry (optional)
  helperRosterId         String?
  helperRoster           ShiftRoster?       @relation("HelperProduction", fields: [helperRosterId], references: [id])
  
  // The Machine involved
  machineId              String
  machine                Machine            @relation(fields: [machineId], references: [id])
  
  // The Metrics
  stitchCount            Int
  stopCount              Int?
  designName             String?

  // Indexing to find production by the roster/shift
  @@index([operatorRosterId, machineId]) 
}


//INFO: Financial & Asset Logs
model Payment {
  id                     String             @id @default(uuid())
  date                   DateTime           @default(now())
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  amount                 Decimal
  type                   PaymentType
  notes                  String?
}

// Factory Expenses (General Costs)
model Expense {
  id                     String             @id @default(uuid())
  date                   DateTime           @default(now())
  category               ExpenseCategory
  itemName               String
  amount                 Decimal
}

// Machine-Specific Maintenance Log
model Maintenance {
  id                     String             @id @default(uuid())
  machineId              String
  machine                Machine            @relation(fields: [machineId], references: [id])
  date                   DateTime           @default(now())
  cost                   Decimal
  reason                 String?
  technician             String?
}

// Global Factory Calendar
model Holiday {
  id                     String             @id @default(uuid())
  date                   DateTime           @unique
  name                   String
}

// Machine Assignments
model MachineAssignment {
  id                     String             @id @default(uuid())
  
  machineId              String
  machine                Machine            @relation(fields: [machineId], references: [id])
  
  userId                 String
  user                   User               @relation(fields: [userId], references: [id])
  
  assignedAt             DateTime           @default(now())
  endedAt                DateTime?
  isActive               Boolean            @default(true)

  @@index([userId, isActive])
}